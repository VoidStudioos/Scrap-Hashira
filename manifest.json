{
  "manifest_version": 3,
  "name": "Hashira Scraper",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Local-first multi-site data extraction, image downloads, durable jobs and exports.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "sidePanel",
    "alarms",
    "offscreen"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hashira Scraper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "sidepanel.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
